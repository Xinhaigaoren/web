# 后端端口：本地测试默认 3000
PORT=3000

# 允许访问接口的前端网站地址。上线后建议改成你的 GitHub Pages 地址。
# 多个地址用英文逗号隔开；测试阶段可暂时用 *
CORS_ORIGIN=https://zxw-hub.github.io

# 管理员登录账号密码。上线前必须改强密码。
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# 用于签发后台登录 token。上线前改成一串长随机字符。
TOKEN_SECRET=replace-with-a-long-random-secret

# 数据文件保存位置
DATA_FILE=./data/applications.json

# 微信登录（可选）：在微信开放平台申请网站应用后填写
# WECHAT_APPID=wx1234567890abcdef
# WECHAT_SECRET=your-wechat-app-secret
# WECHAT_LOGIN_REDIRECT=https://zxw-hub.github.io/hailin-high-school-alumni/account.html
# 数据库连接（PostgreSQL / Supabase）。不配置则后端只做接口骨架，无法存取数据。
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# 前台网站地址（用于生成活动签到链接等）
# PUBLIC_SITE_URL=https://zwx-hub.github.io/hailin-high-school-alumni